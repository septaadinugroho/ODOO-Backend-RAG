# ─── Service ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ───────────────────────────────────────────────────────────────
# Port 5433 on purpose: 5432 is already taken by the python-backend-RAG project.
DATABASE_URL=postgresql+psycopg2://classbot:classbot@127.0.0.1:5433/classbot

# ─── Auth (NFR-D) ───────────────────────────────────────────────────────────
# One key per consumer, format "consumer:key", comma-separated.
# Odoo and the frontend MUST use separate keys.
API_KEYS=odoo:odoo-dev-key-change-me,frontend:frontend-dev-key-change-me
# Set to false only for local Swagger poking. Never false in production.
REQUIRE_API_KEY=true

# ─── Rate limit (NFR-C: 60 req/min per API key, then HTTP 429) ──────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Session context (FR-28 / NFR-B: 30 min, in-memory, not persisted) ──────
SESSION_TTL_SECONDS=1800
MAX_CONCURRENT_SESSIONS=200

# ─── Retrieval limits (NFR-B) ───────────────────────────────────────────────
MAX_RESULTS=20
# FR-10: more than this many candidates => state needs_clarification
CLARIFY_THRESHOLD=20
MAX_RESPONSE_BYTES=102400
# DD open question D3: "Malaysia" and "Multi-state" are not real states, they
# mark cross-region providers. true = a Selangor search also sees them.
INCLUDE_CROSS_REGION_STATES=true

# ─── Query understanding (FR-7, FR-8) ───────────────────────────────────────
# Typo tolerance. A match below FUZZY_MIN_SCORE is discarded rather than
# guessed at, and if the runner-up is within FUZZY_MIN_MARGIN the result is
# treated as ambiguous and the user is asked (FR-9 forbids guessing).
FUZZY_MIN_SCORE=86
# Short fragments need a higher bar: at four characters, one wrong letter is a
# large share of the word, so "amath" would otherwise reach several subjects.
FUZZY_MIN_SCORE_SHORT=92
FUZZY_SHORT_TERM_CHARS=5
FUZZY_MIN_MARGIN=4
# NFR-H: data/synonyms.json is re-read when its mtime changes, no redeploy
# needed. This throttles how often the file is stat()ed, per request thread.
SYNONYMS_RELOAD_SECONDS=2.0

# ─── LLM provider (NFR-H: swap model via config, no logic change) ───────────
# vertex = Google Vertex AI · null = no LLM, always answers in degraded mode
# (the "null" provider lets you demo /docs without GCP credentials)
LLM_PROVIDER=vertex
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_MS=500

# ─── Vertex AI ──────────────────────────────────────────────────────────────
# Auth uses Application Default Credentials:
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.0-flash
VERTEX_MAX_OUTPUT_TOKENS=800
VERTEX_TEMPERATURE=0.2

# ─── Cost guardrail (NFR-E) ─────────────────────────────────────────────────
COST_PER_QUERY_LIMIT_RM=0.05
MONTHLY_BUDGET_RM=500
COST_ALERT_THRESHOLD=0.8

# ─── Data files ─────────────────────────────────────────────────────────────
# The real 200-record corpus. It is not in the repository yet — the file that
# was shared was the Data Dictionary PDF, not the CSV. Until it arrives, point
# this at the 12-record fixture, which has the same 23 columns and covers every
# facet group:
#   CORPUS_CSV=data/sample_corpus.csv
CORPUS_CSV=data/malaysia_tuition_classes_rag_200.csv
SYNONYMS_PATH=data/synonyms.json
